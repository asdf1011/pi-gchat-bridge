# ---- Google Chat bot identity ---------------------------------------------
# Service account JSON key downloaded from Google Cloud Console
# (IAM & Admin > Service Accounts > your Chat app service account > Keys)
GOOGLE_SERVICE_ACCOUNT_JSON=/absolute/path/to/service-account.json

# ---- Pub/Sub receiver ------------------------------------------------------
# Pull subscription on the topic the Chat app publishes events to.
PUBSUB_SUBSCRIPTION=projects/your-project/subscriptions/chat-events-sub

# ---- engine -----------------------------------------------------------------
# durable = Pi Durable (default). sdk = the old SDK host, kept for rollback.
BRIDGE_ENGINE=durable
# The durable store. ONE process owns it; a second refuses to start.
BRIDGE_DB=./bridge.sqlite

# ---- pi agent --------------------------------------------------------------
# Working directory pi sessions operate in (tools: read/bash/edit/write)
PI_CWD=/workspace

# Legacy paths — read by the one-shot importer and by BRIDGE_ENGINE=sdk only.
BRIDGE_SESSIONS_DIR=./sessions
BRIDGE_STATE_FILE=./state.json

# ---- Web frontend -------------------------------------------------------------
# Loopback by default: an identity-aware proxy (Cloudflare Tunnel + Access, or
# tailscale serve) goes in front. Binding 0.0.0.0 exposes a bot that can run
# shell commands.
BRIDGE_BIND=127.0.0.1
# Socket peer whose identity headers are believed (e.g. 127.0.0.1 when
# cloudflared runs on this host). Empty = trust none.
BRIDGE_TRUSTED_PROXY=127.0.0.1
# Optional bearer token for web writes. Empty = rely on the proxy alone.
BRIDGE_WEB_TOKEN=

# ---- Health -----------------------------------------------------------------
# HTTP health endpoint (0 disables; used by Docker healthcheck)
PORT=8080

# ---- Watchdog (stuck-session recovery) ---------------------------------------
# If a session is streaming with no agent activity for this long (ms) — e.g. a
# hung tool call like a network fetch without a timeout — it is force-aborted
# and reopened from the last completed turn. 0 disables.
BRIDGE_STALL_TIMEOUT_MS=1200000
# How often the watchdog scans for stalled sessions (ms)
BRIDGE_WATCHDOG_INTERVAL_MS=30000

# ---- Logging -------------------------------------------------------------------
# Minimum level to emit: debug | info | warn | error (default info)
LOG_LEVEL=info

# ---- Allow-list (security) ---------------------------------------------------
# Optional. Comma-separated list of spaces (resource name or ID, e.g.
# "spaces/AAAA" or "AAAA") the bridge will respond in. Empty = all spaces.
#ALLOWED_SPACES=spaces/AAAA,spaces/BBBB
# Optional. Comma-separated list of user resource names (or IDs) allowed to
# trigger pi with a message OR a card click. Empty = anyone. NOTE: matched
# against the sender's "users/<id>" resource name, not their email.
# Card clicks are included because one of them opens the /secret value card.
#ALLOWED_USERS=users/123456789
# Optional. Who may use /secret at all (list, set, remove). Empty = inherit
# ALLOWED_USERS. Worth setting separately if someone may chat but should not see
# the secret inventory. Accepts a users/<id> resource name or a web identity
# email, since /web submissions carry the Cloudflare email rather than a Chat id.
#SECRET_USERS=users/123456789
# Where /secret stores captured values. Defaults to ~/.pi-bridge/secrets.json,
# deliberately outside PI_CWD so the agent's `read`/`bash` do not sit next to it.
#BRIDGE_SECRETS_FILE=/root/.pi-bridge/secrets.json

# ---- Cloudflare Tunnel (optional) -------------------------------------------
# The tunnel token is NOT set here. Do this in Chat instead:
#
#     /secret set TUNNEL_TOKEN
#
# start-bridge.sh reads it from the bridge's secret store, so it never sits in a
# file this shell sources (a TUNNEL_TOKEN here would be exported by `set -a` into
# the bridge and every `bash` tool call). No token means no tunnel, which is a
# fine state — Chat still works.

# ---- Steer (interleaved messages) -------------------------------------------
# How long to wait for an in-flight tool call to finish before aborting and
# redirecting instead (so an interjection is never stuck behind a long tool).
BRIDGE_STEER_WAIT_MS=10000

# ---- Session idle eviction (memory) -------------------------------------------
# Evict a non-streaming session from memory after this long (ms). The JSONL file
# persists, so the next message reopens it. 0 disables (default).
#BRIDGE_SESSION_IDLE_MS=1800000

# ---- Conversation topic titles (gchat display only) -------------------------
# When /model starts a conversation, its "Model switched" card is the thread's
# top message, so it's the one line the space's conversation list shows. After
# the first reply, a LOCAL model is asked for a one-line topic and that card's
# header is patched with it (the body keeps the model name). Nothing is written
# to the session, so pi's history is untouched. Set to 0 to keep the plain
# "Model switched" wording.
#BRIDGE_TOPIC_SUMMARY=1
# OpenAI-compatible endpoint of the local model (llama.cpp server).
#BRIDGE_TOPIC_SUMMARY_BASE_URL=http://127.0.0.1:8090/v1
#BRIDGE_TOPIC_SUMMARY_MODEL=lfm3-vl-2b-q8
# CPU inference is slow and the server may have a single slot, so the title job
# waits this long before giving up. It runs detached, behind the reply.
#BRIDGE_TOPIC_SUMMARY_TIMEOUT_MS=900000

# ---- Google Chat bot identity ---------------------------------------------
# Service account JSON key downloaded from Google Cloud Console
# (IAM & Admin > Service Accounts > your Chat app service account > Keys)
GOOGLE_SERVICE_ACCOUNT_JSON=/absolute/path/to/service-account.json

# ---- Pub/Sub receiver ------------------------------------------------------
# Pull subscription on the topic the Chat app publishes events to.
PUBSUB_SUBSCRIPTION=projects/your-project/subscriptions/chat-events-sub
# How often to pull for new events (ms)
PULL_INTERVAL_MS=1000

# ---- pi agent --------------------------------------------------------------
# Working directory pi sessions operate in (tools: read/bash/edit/write)
PI_CWD=/workspace
# Per-space pi session files live here
BRIDGE_SESSIONS_DIR=./sessions
# Message dedupe state
BRIDGE_STATE_FILE=./state.json

# ---- Health -----------------------------------------------------------------
# HTTP health endpoint (0 disables; used by Docker healthcheck)
PORT=8080

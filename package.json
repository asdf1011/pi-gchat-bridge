{
  "name": "pi-gchat-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bridge between Google Chat and the pi coding agent",
  "scripts": {
    "start": "tsx src/durable/main.ts",
    "start:sdk": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "evals": "node evals/run.mjs",
    "evals:regrade": "node evals/regrade.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-durable": "^1.4.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}

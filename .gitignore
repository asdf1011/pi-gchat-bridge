# Eval run artifacts (results/summary/report per run)
evals/runs/
sessions.pre-1.4.0/
.env.durable

# Pi Durable store and its runtime companions. The database is the live bridge
# state: never commit it, and never commit SQLite's WAL/SHM or the pid lock.
bridge.sqlite
bridge.sqlite-shm
bridge.sqlite-wal
bridge.sqlite.lock
# The bridge's own delivery cursor: runtime state, not source.
bridge-ledger.json
bridge-ledger.json.*.tmp
# Legacy session backups taken before the 1.4.0 upgrade and the cutover.
sessions.pre-1.4.0/
backups/

# Playwright
test-results/
playwright-report/

# Runtime: the supervisor pid file, rewritten at every start.
.start-bridge.pid

# The bridge's own delivery cursor: runtime state, not source.
bridge-ledger.json
bridge-ledger.json.*.tmp

# The newline-separated keys .env.durable last defined: runtime state.
.env.durable.keys
